{
  "name": "shopit",
  "version": "0.1.0",
  "private": true,
  "description": "ShopIT – backend (Express), static frontend and database tools",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node backend/server.mjs",
    "dev": "node --watch backend/server.mjs",
    "db:status": "node database/manage.mjs status",
    "db:migrate": "node database/manage.mjs migrate",
    "db:upgrade": "node database/manage.mjs upgrade",
    "db:seed": "node database/manage.mjs seed",
    "db:verify": "node database/manage.mjs verify"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}
