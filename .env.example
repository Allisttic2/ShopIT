# Copy to .env and fill in. neon deploy creates .env.local.
# Use the exact TLS parameters from Neon; never commit real credentials.
#
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_BRANCH=production

# Backend
PORT=3000
# Demo login is disabled by default and is never accepted with NODE_ENV=production.
# SchoolSoft SSO setup still requires the school's IT team; see backend/SCHOOLSOFT.md.
DEMO_AUTH_ENABLED=false
# Only for an explicitly enabled local demo. Set a password of at least 8 characters.
DEMO_PASSWORD=
# Required: generate a random value (at least 32 bytes); there is no fallback secret.
AUTH_SECRET=
# Base URL used if e-mails link back to the app.
PUBLIC_BASE_URL=http://localhost:3000

# Order confirmation e-mail. Leave SMTP_HOST empty locally: e-mails are then
# saved as HTML, PDF and .eml files in backend/mail-outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NTI-T Shopp <no-reply@ntitshopp.local>
