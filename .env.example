# Copy to .env and fill in. neon deploy creates .env.local.
# Use the exact TLS parameters from Neon; never commit real credentials.
#
# Local demo database (docker compose up -d db, port 5433):
# DATABASE_URL=postgresql://shopit:shopit@localhost:5433/shopit
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_BRANCH=production

# Backend
PORT=3000
# All demo accounts (seeded schools and new registrations) log in with this password.
DEMO_PASSWORD=demo1234
# HMAC secret for session tokens – set a long random value for shared demos.
AUTH_SECRET=change-me
# Base URL used if e-mails link back to the app.
PUBLIC_BASE_URL=http://localhost:3000

# Order confirmation e-mail. Leave SMTP_HOST empty locally: e-mails are then
# saved as HTML in backend/mail-outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NTI-T Shopp <no-reply@ntitshopp.local>
